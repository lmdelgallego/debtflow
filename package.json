{
  "name": "debtflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "turbo run dev --parallel --filter=@debtflow/web --filter=@debtflow/mobile",
    "dev:web": "pnpm --filter @debtflow/web dev",
    "dev:mobile": "pnpm --filter @debtflow/mobile dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "globals": "^16.4.0",
    "prisma": "^7.2.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
